# Porta do Postgres no HOST (padrão 5432).
# Se a 5432 já estiver ocupada na sua máquina, troque aqui E na DATABASE_URL (ex.: 5433).
DB_PORT=5432
DATABASE_URL="postgresql://echo:echo@localhost:5432/echo?schema=public"

# Conexão usada SÓ pelas migrations (`prisma migrate`). Localmente é idêntica à
# DATABASE_URL. Em produção com pooler (Neon, Supabase), aqui vai a string "direct":
# o `migrate deploy` não consegue segurar os advisory locks através do pooler.
DIRECT_URL="postgresql://echo:echo@localhost:5432/echo?schema=public"

# Porta da API
PORT=3333

# URL do frontend (para onde o QR Code aponta)
WEB_BASE_URL="http://localhost:5173"

# Origens permitidas no CORS (separadas por vírgula). Se vazio, libera geral (dev).
# Ex.: CORS_ORIGIN="http://localhost:5173"
CORS_ORIGIN=

# Segredo usado para assinar o JWT. Gere um valor longo e aleatorio em producao.
# Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-valor-em-producao"

# Validade do token da gestao (ex.: 8h, 1d).
JWT_EXPIRES_IN=8h
