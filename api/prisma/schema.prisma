// Echo — Schema inicial do banco (v1 · rascunho para revisão do time de BD)
// Escopo: entidades do MVP 1 (feedback do cliente + login da gestão).
// Ajustar nomes/campos no Bloco 1 (18–20/08) junto com o backend.

generator client {
  provider = "prisma-client-js"
}

// url é a conexão da aplicação; directUrl é usada só pelas migrations.
// Em provedores com pooler na frente (Neon, Supabase), o `migrate deploy` não
// consegue segurar os advisory locks através do pooler — por isso a conexão direta.
// Em desenvolvimento as duas apontam para o mesmo Postgres local.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum Papel {
  COORDENADOR
  GERENTE
  ADMINISTRADOR
}

enum TipoFeedback {
  ELOGIO
  SUGESTAO
  RECLAMACAO
}

enum StatusOcorrencia {
  PENDENTE
  EM_ANDAMENTO
  RESOLVIDO
}

// ---------- Gestão / autenticação ----------

model User {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String
  papel     Papel
  criadoEm  DateTime @default(now())

  tratativas Feedback[]
}

// ---------- Estabelecimento e QR ----------

model Venue {
  id        String     @id @default(uuid())
  nome      String
  areas     Area[]
  feedbacks Feedback[]
  criadoEm  DateTime   @default(now())
}

model Area {
  id        String     @id @default(uuid())
  nome      String
  venue     Venue      @relation(fields: [venueId], references: [id])
  venueId   String
  qrCodes   QRCode[]
  feedbacks Feedback[]

  // Duas áreas de mesmo nome no mesmo restaurante viravam duas barras
  // indistinguíveis no dashboard. O nome se repetir entre restaurantes é legítimo
  // (toda casa tem uma "Mesa 1"), por isso a chave é composta com o venueId.
  @@unique([venueId, nome])
}

model QRCode {
  id       String   @id @default(uuid())
  token    String   @unique
  ativo    Boolean  @default(true)
  area     Area     @relation(fields: [areaId], references: [id])
  areaId   String
  criadoEm DateTime @default(now())
}

// ---------- Feedback ----------

model Category {
  id      String           @id @default(uuid())
  nome    String           @unique
  ratings FeedbackRating[]
}

model Feedback {
  id           String           @id @default(uuid())
  venue        Venue            @relation(fields: [venueId], references: [id])
  venueId      String
  area         Area?            @relation(fields: [areaId], references: [id])
  areaId       String?
  tipo         TipoFeedback
  comentario   String?
  anonimo      Boolean          @default(true)
  contatoEmail String?
  avaliacoes   FeedbackRating[]
  criadoEm     DateTime         @default(now())

  // Tratativa: quem da gestão mexeu na ocorrência e quando.
  status       StatusOcorrencia @default(PENDENTE)
  tratadoPor   User?            @relation(fields: [tratadoPorId], references: [id])
  tratadoPorId String?
  tratadoEm    DateTime?

  @@index([venueId, criadoEm])
  @@index([status])
}

model FeedbackRating {
  id         String   @id @default(uuid())
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  feedbackId String
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String
  estrelas   Int // 1 a 5

  @@unique([feedbackId, categoryId])
}
