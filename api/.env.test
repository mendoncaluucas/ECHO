# Ambiente dos testes automatizados. Versionado de propósito: não contém segredo real,
# aponta para o banco efêmero (serviço db-test) e serve tanto localmente quanto no CI.

DB_TEST_PORT=5440
DATABASE_URL="postgresql://echo:echo@localhost:5440/echo_test?schema=public"
# Sem pooler no Postgres local, então é a mesma conexão. Em produção difere.
DIRECT_URL="postgresql://echo:echo@localhost:5440/echo_test?schema=public"

JWT_SECRET="segredo-apenas-para-testes"

WEB_BASE_URL="http://localhost:5173"

# E-mail desligado de propósito, mesmo que o .env de quem desenvolve tenha a chave do
# Resend: vazio aqui, o dotenv do app.ts não sobrescreve. Os testes usam um provedor falso.
RESEND_API_KEY=
EMAIL_DESTINO_TESTE=
